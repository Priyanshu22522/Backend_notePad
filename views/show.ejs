<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= filename %> · TaskVault</title>
    <link rel="stylesheet" href="/stylesheets/style.css">
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="paper min-h-screen text-[#1c1c1a]">

    <div class="max-w-3xl mx-auto px-6 py-12 fade-in">

        <a class="ink-link inline-flex items-center gap-1.5 text-sm font-mono-note font-bold mb-10" href="/">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
            </svg>
            back to the pile
        </a>

        <div class="hard-shadow-static bg-[#fffdf7] border-2 border-[#1c1c1a] p-8 relative rotate-[-0.5deg]">
            <div class="tape"></div>

            <span class="font-mono-note text-[11px] uppercase tracking-widest text-[#8a8378]">reading note</span>
            <h1 class="text-3xl font-bold tracking-tight break-all mt-1 mb-6"><%= filename %></h1>

            <p class="font-mono-note text-[15px] leading-relaxed whitespace-pre-wrap border-t-2 border-dashed border-[#1c1c1a]/20 pt-6"><%= filedata %></p>
        </div>

    </div>
</body>
</html>