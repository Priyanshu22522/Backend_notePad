<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Rename · TaskVault</title>
    <link rel="stylesheet" href="/stylesheets/style.css">
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="paper min-h-screen text-[#1c1c1a]">

    <div class="max-w-md mx-auto px-6 py-12 fade-in">

        <a class="ink-link inline-flex items-center gap-1.5 text-sm font-mono-note font-bold mb-10" href="/">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
            </svg>
            back to the pile
        </a>

        <div class="hard-shadow-static bg-[#fffdf7] border-2 border-[#1c1c1a] p-6 relative rotate-[0.6deg]">
            <span class="absolute -top-3 -left-3 bg-[#e8c468] text-[#1c1c1a] text-xs font-mono-note font-bold px-2 py-1 border-2 border-[#1c1c1a] rotate-[-3deg]">RENAME</span>

            <h2 class="font-mono-note text-xs uppercase tracking-widest text-[#5a5348] mb-5 mt-2">give it a new name</h2>

            <form action="/edit" method="post" class="space-y-4">
                <div>
                    <label class="block text-[11px] font-mono-note uppercase tracking-widest text-[#8a8378] mb-1.5">current name</label>
                    <input
                        class="block w-full px-4 py-2.5 bg-[#efe7d8]/60 border-2 border-dashed border-[#1c1c1a]/30 outline-none text-[#5a5348] font-mono-note text-sm cursor-not-allowed"
                        type="text" name="previous" value="<%= filename %>" readonly>
                </div>

                <div>
                    <label class="block text-[11px] font-mono-note uppercase tracking-widest text-[#8a8378] mb-1.5">new name</label>
                    <input
                        class="ink-focus block w-full px-4 py-2.5 bg-[#efe7d8] border-2 border-[#1c1c1a] outline-none text-[#1c1c1a] font-mono-note text-sm placeholder-[#8a8378]"
                        type="text" placeholder="new-file-name" name="new" required>
                </div>

                <button
                    class="hard-shadow inline-flex items-center gap-2 bg-[#e8c468] text-[#1c1c1a] border-2 border-[#1c1c1a] px-5 py-2.5 font-bold mt-1"
                    type="submit">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                    </svg>
                    Update name
                </button>
            </form>
        </div>

    </div>
</body>
</html>